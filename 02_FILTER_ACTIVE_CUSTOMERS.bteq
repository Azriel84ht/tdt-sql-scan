-- Fichero: 02_FILTER_ACTIVE_CUSTOMERS.bteq
-- Proposito: Crear una tabla volatil con los clientes activos para el ciclo de facturacion.
.LOGON tdp_id/user,password;
.DATABASE STAGING_DB;

-- Creamos una tabla volatil que solo existira durante esta sesion.
-- Esta tabla sera la base para los siguientes calculos.
CREATE VOLATILE TABLE VT_ACTIVE_CUSTOMERS AS (
    SELECT
        customer_id,
        plan_type
    FROM
        PROD_DB.CUSTOMERS
    WHERE
        status = 'ACTIVE'
) WITH DATA
ON COMMIT PRESERVE ROWS;

.LOGOFF;
.EXIT;
